# ============================================
# Continuity - Self-Improving Agent System
# .dockerignore
# ============================================
# This file excludes files from Docker build context
# to speed up builds and reduce image size

# ============================================
# Git
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# Documentation (not needed in containers)
# ============================================
*.md
!requirements*.md
docs/
missions/
LICENSE
CHANGELOG

# ============================================
# Environment Files
# ============================================
.env
.env.*
!.env.example
*.env

# ============================================
# Python
# ============================================
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/
.nox/
.hypothesis/

# ============================================
# Node.js
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build outputs (we build fresh in container)
.next/
out/

# ============================================
# IDE & Editors
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ============================================
# Docker
# ============================================
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.docker/

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
tests/
test/
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx

# ============================================
# Local Data
# ============================================
data/
logs/
*.log
tmp/
temp/
uploads/
generated/
outputs/

# ============================================
# Weave / Weights & Biases
# ============================================
wandb/
weave/
artifacts/

# ============================================
# Miscellaneous
# ============================================
*.bak
*.tmp
*.temp
Makefile
