# ============================================
# Continuity - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================

# ============================================
# Google Gemini API
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Weights & Biases (Weave)
# ============================================
# Get your API key from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
WANDB_ENTITY=your_wandb_entity_here
WEAVE_PROJECT_NAME=continuity

# ============================================
# PostgreSQL Database
# ============================================
# For Docker Compose, these are used to initialize the database
POSTGRES_USER=continuity
POSTGRES_PASSWORD=continuity_dev_password
POSTGRES_DB=continuity

# Connection URL (used by the backend)
# For Docker: postgresql://continuity:continuity_dev_password@postgres:5432/continuity
# For local: postgresql://continuity:continuity_dev_password@localhost:5432/continuity
DATABASE_URL=postgresql://continuity:continuity_dev_password@postgres:5432/continuity

# ============================================
# Redis
# ============================================
# For Docker: redis://redis:6379/0
# For local: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ============================================
# Browserbase (Web Automation)
# ============================================
# Get your API key from: https://www.browserbase.com/
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# Stagehand Model API Key for AI-powered browser automation
# Stagehand supports multiple providers: Google (Gemini), OpenAI, Anthropic
# For Gemini, use the same key as GEMINI_API_KEY (recommended - no extra cost!)
# See: https://docs.stagehand.dev/v3/configuration/models
STAGEHAND_MODEL_API_KEY=your_gemini_api_key_here

# Google API key for Stagehand (alternative env var name that Stagehand looks for)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (enables verbose logging)
DEBUG=true

# Backend URL (for frontend to connect)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# ============================================
# Optional: Model Configuration
# ============================================
# Default model for generation
DEFAULT_MODEL=gemini-2.0-flash

# Gemini model overrides (optional)
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_ASPECT_RATIO=16:9
GEMINI_IMAGE_SIZE=2K

# Maximum iterations per phase
MAX_ITERATIONS=5

# Quality threshold for acceptance (0.0 - 1.0)
QUALITY_THRESHOLD=0.7
